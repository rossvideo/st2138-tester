{
  "name": "test-your-catena",
  "version": "1.0.0",
  "description": "Web app for testing REST/gRPC Catena/ST2138 devices",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc && node scripts/copy-ui.mjs",
    "test": "node --require ts-node/register --test tests/*.test.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "catena",
    "st2138",
    "rest",
    "grpc",
    "testing"
  ],
  "author": "",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "json-source-map": "^0.6.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
